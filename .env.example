# Smart Router Go Configuration
SMART_ROUTER_PORT=8790
SMART_ROUTER_HOST=0.0.0.0
SMART_ROUTER_ADMIN_KEY=change-me-to-a-long-random-string
SMART_ROUTER_DB_PATH=./data/smart-router.db
SMART_ROUTER_HEALTH_PATH=./data/health
CONFIG_PATH=./config/plans.yaml
LOG_LEVEL=info

# Telegram bot for alerts and commands (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# AES-256-GCM encryption key for provider API keys at rest.
# Generate with: openssl rand -base64 32
KEY_ENCRYPTION_KEY=
